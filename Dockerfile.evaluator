# CS5491: Reasoning Augmented FunSearch
# Author: 李逸洋 (72655555)
# Responsibility: Benchmark preparation and evaluation scripts

FROM python:3.13-alpine
RUN pip install --no-cache-dir numpy==2.2.6
RUN mkdir -p /app/funsearch_project && chmod 755 /app /app/funsearch_project
WORKDIR /app
USER 65534:65534
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "-I", "/app/funsearch_project/worker.py"]
